rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- ヘルパー関数 ---
    
    // 管理者（inoue@ajiado.co.jp）かどうかを判定
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'inoue@ajiado.co.jp';
    }

    // 自分のデータかどうかを判定
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // --- コレクションごとのルール ---

    // 1. 実行ログ (activityLogs)
    match /activityLogs/{logId} {
      // 読み取り: マスターアカウントのみ許可
      allow read: if isAdmin();
      // 書き込み: 認証済みユーザーなら誰でも許可（匿名認証での閲覧ログを記録するため）
      allow create: if request.auth != null;
      // 更新・削除: ログの性質上、改ざんを禁止
      allow update, delete: if false;
    }

    // 2. 権限管理 (permissions)
    match /permissions/{email} {
      allow read: if true; 
      allow write: if isAdmin() || (request.auth != null && request.auth.token.email == email);
    }

    // 3. クライアント管理 (clients)
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 4. プロジェクト管理 (projects)
    match /projects/{projectId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      
      // 更新: 管理者、または「承認済み」へのステータス変更のみ許可
      allow update: if isAdmin() || 
        (request.resource.data.orderConfirmationStatus == '承認済み' && resource.data.orderConfirmationStatus == '承認待ち');
      
      // サブコレクション: 発注書 (purchaseOrders)
      match /purchaseOrders/{poId} {
        allow read, write: if request.auth != null;
      }
    }

    // 5. 出納帳 (ledgerReports)
    match /ledgerReports/{reportId} {
      allow read, write: if request.auth != null;
    }

    // 6. 科目管理 (ledgerSubjects)
    match /ledgerSubjects/{subjectId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 7. 通知 (notifications)
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if false; // Cloud Functions側で作成するため
    }
  }
}