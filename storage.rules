rules_version = '2';

// 領収書などの添付ファイルは社員 (permissions 登録済み) のみ扱える。
// 承認ページ (匿名) での表示は、トークン付きのダウンロードURL経由なのでこのルールの対象外。
service firebase.storage {
  match /b/{bucket}/o {

    function isStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/permissions/$(request.auth.token.email));
    }

    function isAdmin() {
      return isStaff()
        && firestore.get(/databases/(default)/documents/permissions/$(request.auth.token.email)).data.get('isAdmin', false) == true;
    }

    match /receipt-images/{uid}/{fileName} {
      allow read: if isStaff();
      // アップロードは自分のフォルダにのみ・20MB以下。
      // ブラウザで開くとスクリプトが動く形式 (HTML/SVG/XML/JS) は禁止
      // 同じパスへの上書きも create として扱われるため、既存ファイルがない場合のみ許可する
      allow create: if isStaff()
        && resource == null
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && !request.resource.contentType.lower().matches('(text/html|application/xhtml\\+xml|image/svg\\+xml|text/xml|application/xml|(text|application)/(x-)?(java|ecma)script)(;.*)?');
      // 電子帳簿保存法の保存義務 (7年) があるため、添付ファイルの上書き・削除は禁止。
      // 添付し直したときは新しいファイル名で保存される
      allow update, delete: if false;
    }

    // 会社のロゴ・角印 (帳票に印字)。画像のみ・5MB以下・管理者のみアップロード
    match /company-assets/{fileName} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && resource == null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow update, delete: if false;
    }

    // 上記以外のパスはすべて拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
